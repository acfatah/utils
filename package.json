{
  "name": "@acfatah/utils",
  "type": "module",
  "version": "2.0.0",
  "private": false,
  "description": "Copy Paste Javascript Utilities.",
  "author": "Achmad F. Ibrahim <acfatah@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/acfatah/utils#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/acfatah/utils.git"
  },
  "bugs": {
    "url": "https://github.com/acfatah/utils/issues"
  },
  "keywords": [],
  "main": "index.js",
  "scripts": {
    "dev": "bun test --watch test/",
    "build": "bun detypes lib dist",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "precommit": "bun run lint:fix && bun run build",
    "clean": "del-cli coverage",
    "test": "bun test test/",
    "test:coverage": "bun test --coverage test/",
    "test:coverage-generate": "bun run clean && bun test --coverage --coverage-reporter=lcov test/ && lcov-viewer lcov -o ./coverage ./coverage/lcov.info",
    "test:coverage-report": "bun run test:coverage-generate && bunx http-server -p 8888 coverage/",
    "release": "release-it"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^4.12.0",
    "@lcov-viewer/cli": "^1.3.0",
    "@rushstack/eslint-patch": "^1.11.0",
    "@types/bun": "^1.2.9",
    "@vitest/coverage-istanbul": "^1.6.1",
    "del-cli": "^6.0.0",
    "detypes": "^0.8.0",
    "eslint": "^9.24.0",
    "eslint-plugin-format": "^1.0.1",
    "release-it": "^17.11.0",
    "simple-git-hooks": "^2.12.1"
  }
}
